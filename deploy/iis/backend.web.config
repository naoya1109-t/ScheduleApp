<?xml version="1.0" encoding="utf-8"?>
<!--
  IISサイトの/api配下(または/apiをパスとする専用のIISアプリケーション)に配置する。
  前提: ARR(Application Request Routing)とURL Rewriteモジュールが導入済みであること。
  前提: バックエンドのNode.jsプロセスは、Windowsサービスとして常駐し、
        localhostの内部ポート(既定3001。backend/.envのPORTと一致させる)でのみ待ち受けていること。
  ポート番号を変更した場合は、下記rewriteMapのURLも合わせて変更する。
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Reverse proxy to Node.js backend" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:3001/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
